{
  "name": "dsh-custom-mode",
  "version": "0.1.6-alpha.1",
  "description": "Settings page for the dsh-custom-mode agent preset: base-mode switching, per-row plugin switches, an editable system prompt, and mode renaming. Follows the DSH version.",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BOWLUNA/dsh-custom-mode.git",
    "directory": "editor"
  },
  "homepage": "https://github.com/BOWLUNA/dsh-custom-mode#readme",
  "bugs": {
    "url": "https://github.com/BOWLUNA/dsh-custom-mode/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-preset",
    "system-prompt",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.mjs",
    "client.js",
    "composition.mjs",
    "meta.mjs",
    "paths.mjs",
    "locales.mjs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node ../test/run.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.2-alpha.1"
  },
  "publishConfig": {
