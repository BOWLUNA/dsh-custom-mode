{
  "name": "dsh-custom-mode",
  "version": "1.3.0",
  "description": "Custom modes and custom prompts for DeepSeek Harness (dsh): edit a mode's system prompt on the settings page (it takes effect on the next model step), choose its base mode, switch plugins row by row, and keep several assistants side by side.",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BOWLUNA/dsh-custom-mode.git",
    "directory": "editor"
  },
  "homepage": "https://github.com/BOWLUNA/dsh-custom-mode#readme",
  "bugs": {
    "url": "https://github.com/BOWLUNA/dsh-custom-mode/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "agent-mode",
    "custom-mode",
    "multi-mode",
    "assistant",
    "system-prompt",
    "custom-prompt",
    "prompt-editor",
    "prompt-engineering",
    "persona"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.mjs",
    "assistants.mjs",
    "seed.mjs",
    "client.js",
    "composition.mjs",
    "meta.mjs",
    "paths.mjs",
    "locales.mjs",
    "journal.mjs",
    "cordis.patch.yml",
    "preset/"
  ],
  "scripts": {
    "test": "node ../test/run.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.6-alpha.1 <0.2.0-0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.1.6-alpha.1 <0.2.0-0"
  }
}
