{
  "name": "dsh-custom-mode",
  "version": "1.9.10",
  "description": "Custom modes and custom prompts for DeepSeek Harness (dsh): edit a mode's system prompt on the settings page (it takes effect on the next model step), pick its base mode, switch plugin rows one by one, and keep several assistants side by side — coding, chat or roleplay (RP) personas (multi-mode / multi-agent).",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BOWLUNA/dsh-custom-mode.git",
    "directory": "editor"
  },
  "homepage": "https://github.com/BOWLUNA/dsh-custom-mode#readme",
  "bugs": {
    "url": "https://github.com/BOWLUNA/dsh-custom-mode/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "agent-preset",
    "agent-mode",
    "custom-mode",
    "multi-mode",
    "assistant",
    "system-prompt",
    "custom-prompt",
    "prompt-editor",
    "prompt-engineering",
    "persona",
    "multi-agent",
    "roleplay",
    "chat"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.mjs",
    "assistants.mjs",
    "seed.mjs",
    "atomic.mjs",
    "client.js",
    "composition.mjs",
    "meta.mjs",
    "paths.mjs",
    "locales.mjs",
    "journal.mjs",
    "cordis.patch.yml",
    "preset-backend/",
    "preset/"
  ],
  "scripts": {
    "test": "node ../test/run.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.2 <0.2.0-0 || >=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.1 <0.2.0-0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "peerDependenciesMeta": {
